[Unit]
Description=GAZBOT V7 — watch page (:8087)
After=network.target

[Service]
Type=simple
User=alphabot
WorkingDirectory=/home/alphabot/gazbot7
Environment=GAZBOT7_WEB_PORT=8087
Environment=GAZBOT7_STORE=/home/alphabot/gazbot7/data/gazbot7.db
Environment=GAZBOT7_CAPTURE=/home/alphabot/gazbot7/data/capture.db
ExecStart=/home/alphabot/gazbot7/.venv/bin/python -m gazbot7.web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
