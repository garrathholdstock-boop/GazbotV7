[Unit]
Description=GAZBOT V7 — md (market data: capture.db moat + live stream)
After=network.target

[Service]
Type=simple
Slice=gazbot7.slice
User=alphabot
WorkingDirectory=/home/alphabot/gazbot7
# md is read-only (clientId 2) — it never trades, so no place_live env.
ExecStart=/home/alphabot/gazbot7/.venv/bin/python -m gazbot7.md
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
