<table><thead><tr><th class="ln">Open-rider population</th><th class="num">Sessions</th><th class="num">Held to the clock %</th><th class="num">Net at 2 lots</th><th class="num">$ / session</th><th class="num">Median session</th><th class="num">Best 3 stripped</th></tr></thead><tbody><tr class="row-bad"><td class="ln">every session it fired</td><td class="num">225</td><td class="num">47.1%</td><td class="num">&minus;$20,739.00</td><td class="num">&minus;$92.17</td><td class="num">&minus;$78.00</td><td class="num">&minus;$29,666.00</td></tr><tr class="row-hl"><td class="ln">inside the window</td><td class="num">60</td><td class="num">53.3%</td><td class="num">$825.00</td><td class="num">$13.75</td><td class="num">$124.50</td><td class="num">&minus;$7,745.00</td></tr><tr class="row-bad"><td class="ln">outside it</td><td class="num">165</td><td class="num">44.8%</td><td class="num">&minus;$21,564.00</td><td class="num">&minus;$130.69</td><td class="num">&minus;$112.00</td><td class="num">&minus;$27,477.00</td></tr></tbody></table>

