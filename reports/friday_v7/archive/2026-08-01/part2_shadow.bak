<tr class="row-bad"><td class="ln">07-27 16:28</td><td class="num">32.9</td><td class="num">0.14R</td><td class="num">&minus;68</td><td class="num">&minus;68</td><td class="ln">STOP</td></tr>
<tr class="row-hl"><td class="ln">07-27 18:54 <span class="tag">the runner</span></td><td class="num">24.8</td><td class="num">4.2R</td><td class="num">+23</td><td class="num">+145</td><td class="ln">CHANDELIER</td></tr>
