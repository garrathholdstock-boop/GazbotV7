<tr><td class="ln">07-31</td><td>CHOP 65%</td><td class="num">$7,363</td><td class="num">$7,527</td><td class="num">−$164</td><td class="num">$0</td></tr>
<tr class="row-hl"><td class="ln"><b>WEEK</b></td><td>—</td><td class="num"><b>$15,788</b></td><td class="num"><b>$17,003</b></td><td class="num"><b>−$1,216</b></td><td class="num"><b>$0 (durable days)</b></td></tr>
