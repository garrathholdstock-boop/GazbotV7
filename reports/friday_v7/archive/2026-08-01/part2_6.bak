<tr><td class="ln">Mon 07-28</td><td class="num">5</td><td class="num">1</td><td class="num">20%</td><td>benched shorts under a young UP bias</td><td class="num">−$54</td></tr>
<tr class="row-hl"><td class="ln">Tue 07-29</td><td class="num">78</td><td class="num">9</td><td class="num">12%</td><td>first green day; scale-out live; held longs</td><td class="num">+$638</td></tr>
<tr class="row-bad"><td class="ln">Wed 07-30</td><td class="num">241</td><td class="num">35</td><td class="num">14.5%</td><td>BEST-EVER day but <b>thrashy</b> — grind toggled ~8&times;, one premature flip</td><td class="num">+$1,172</td></tr>
<tr class="row-hl"><td class="ln">Thu 07-31</td><td class="num">289</td><td class="num">13</td><td class="num">4.5%</td><td>durable era; <b>0 routine changes</b> — all 13 were operator/session overrides; held flat</td><td class="num">−$905</td></tr>
