<tr><td class="ln">Mon 07-27</td><td class="ln">abs_veto_long</td><td>LONG</td><td class="num">−51.0</td></tr>
<tr><td class="ln">Mon 07-27</td><td class="ln">abs_veto_long</td><td>LONG</td><td class="num">−43.0</td></tr>
<tr><td class="ln">Mon 07-27</td><td class="ln">abs_veto_long</td><td>LONG</td><td class="num">−35.5</td></tr>
<tr><td class="ln">Tue 07-28</td><td class="ln">abs_veto_long</td><td>LONG</td><td class="num">−38.0</td></tr>
<tr><td class="ln">Tue 07-28</td><td class="ln">abs_veto_short</td><td>SHORT</td><td class="num">−44.5</td></tr>
