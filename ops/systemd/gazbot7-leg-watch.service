[Unit]
Description=GAZBOT V7 — LEG WATCH (a directional leg is running; here is what legs like it did next)
# ★★★ READ-ONLY. No order path, asserted against the source by tests/test_leg_watch.py.
# ★★ DESCRIPTIVE, NEVER PREDICTIVE. Every message carries a REFERENCE CLASS — what legs of this age
# have historically gone on to do — and says in the message that it is not a forecast. All four tape
# states measure 49-50% forward. tunnel_watch shipped a 1.75x claim that did not replicate and ran
# nine hours on it before withdrawal; this one states its own limit in every alert.
# ★ THE ESCALATION IS THE THROTTLE: 17 legs start per session, so the first notice is SILENT and 30
# and 45 minutes are quiet log lines. Only 60/90/120/180 page — and only 33%/16%/9%/5% of legs reach
# those, so they fire ~2.7/1.5/0.85 times a session. The rarer the milestone, the more it has to say.
After=network-online.target gazbot7-md.service

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=PYTHONPATH=src
Environment=GAZBOT7_CAPTURE=/home/alphabot/gazbot7/data/capture.db
Environment=LEG_SYMBOL=MNQ
Environment=LEG_POLL_S=30
Environment=LEG_START_ATR=1.0
Environment=LEG_START_MIN=8
# ⚠ THE PARAMETER THAT MATTERS. At 1xATR the operator's 2026-09-14 morning leg dies on the +20.5pt
# bounce at 08:40 he correctly held through; at 3xATR it survives. Changing this INVALIDATES the
# frozen reference class in leg_watch.REFCLASS — re-derive with scripts/leg_survival.py first.
Environment=LEG_RETRACE_ATR=3.0
Environment=LEG_QUIET=30,45
Environment=LEG_LOUD=60,120,180
# ⚠ THE SIZE GATE — without it this fires ~10 times a session and becomes wallpaper. 9xATR gives
# ★2026-09-15 SET TO 6.0 BY THE OPERATOR: ~4 fires/session, median 36min / 41pt left. He chose
# coverage over rarity — at 9xATR the morning leg he watched (36-48pt on an 8.6 ATR) would not have
# paged, and being told about 40-point legs is worth the extra message or two a day.
Environment=LEG_MIN_ATR=6.0
# ★ THE TUNNEL BREAK, on the displacement axis: a tunnel is the ABSENCE of a leg. >=25min gives
# ~1.5 breaks/session. ⚠ A longer tunnel produces a SMALLER leg (70pt after 0-15min vs 49pt after
# 60min+), so this is a rarity filter and the message says so — never a coiled-spring forecast.
Environment=LEG_TUNNEL_MIN=25
Environment=LEG_STALE_S=300
WorkingDirectory=/home/alphabot/gazbot7
# ⚠ 400M, NOT 256M. gazbot7-tunnel-watch was OOM-killed FOUR times on 2026-09-12 at exactly 256M
# (rss 261MB) while systemd still reported ActiveState=active — a watcher that dies quietly is worse
# than one that never ran.
MemoryMax=400M
Restart=always
RestartSec=20
ExecStart=/home/alphabot/gazbot7/.venv/bin/python scripts/leg_watch.py

[Install]
WantedBy=multi-user.target
