[Unit]
# Every 5 minutes. The off-box check should be configured with a grace of ~15 minutes so a single
# missed ping (a restart, a blip) does not page, but a genuine stop does.
Description=GAZBOT V7 — dead-man's switch heartbeat

[Timer]
OnCalendar=*:0/5:25
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
