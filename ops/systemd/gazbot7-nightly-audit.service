[Unit]
# ★2026-08-02 — the STANDING numbers. Read-only analysis; touches no account, no switches, no config.
#
# Two things that were previously rediscovered by Friday archaeology and are now measured every night:
#
#  1. claim_audit.py — what the operator's hands are worth. Every MANUAL_CLAIM repriced against what
#     its slot's own exit would have done on 250ms ticks. In the 07-27..07-31 week the hands were
#     +$655-862 on twelve trades and it was invisible in every P&L we reported.
# ⛔2026-08-16 — nipc_replay.py REMOVED. The nipc gates were DELETED on 2026-08-15 (operator: "delete
#    nipc gates theyve never done anytjing"), so the replay was grading a control for a gate that can
#    no longer fire — nightly, against a roster it is not on. It also carried a known unfixed bug
#    ([[nipc-replay-truncation-persists-unfixed]]: the same 6-of-12-day output two nights running).
#    The unit was NOT disabled wholesale, because claim_audit.py above is still wanted — that is the
#    whole reason this is a split rather than a `systemctl disable`.
#    The script stays in scripts/ as history; re-add the ExecStart line if nipc is ever revived.
#
# Runs 21:30 UTC — inside the CME maintenance halt (21:00-22:00), so the desk is frozen and the
# Paris-midnight day boundary (22:00 UTC) has not yet rolled.
Description=GAZBOT V7 — nightly standing audit (claim value)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/alphabot/gazbot7
Environment=PYTHONPATH=src
# Leading '-' kept: a failure here must not mark the unit failed and drown the real alarms.
ExecStart=-/home/alphabot/gazbot7/.venv/bin/python scripts/claim_audit.py
# ★2026-08-16 BUILD #7 — record the day's ATR14@1300Z + rider outcome into the Open Rider
#   PRE-REGISTRATION. Without a writer that file was dead: nothing measured the feature, nothing
#   appended, and after 60 sessions it would still have read `sessions: []` with a passing test
#   over it. Runs at 21:30 UTC, inside the CME halt, so the session is complete and the Paris day
#   boundary has not rolled. It records EXCLUDED sessions too — they are half the test.
ExecStart=-/home/alphabot/gazbot7/.venv/bin/python scripts/prereg_tick.py
TimeoutStartSec=3600
Nice=10

[Install]
WantedBy=multi-user.target
