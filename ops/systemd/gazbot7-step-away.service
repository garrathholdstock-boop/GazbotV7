[Unit]
Description=GAZBOT V7 — STEP AWAY guard ("I'm in a meeting, look after this")
# ★★★ IT NEVER TOUCHES THE BROKER. On breach it writes data/day_rider_claim.txt — the SAME file the
# operator's own Claim button writes — and the rider executes it on its own cycle through its own
# ownership check, picked up by the existing inotify fast path in ~0.02s. A button that reached the
# broker directly is how 2026-08-06 happened.
# ★★ MEASURED CASE FOR ARM-WHEN-AWAY (49 entries): armed while he WATCHES it is worth +$95 and
# costs him two big winners; armed while he is AWAY it is worth +$3,257. The value is entirely in
# the trades nobody was watching.
# ⚠ ONE-SHOT: disarms the instant it fires, and at the 22:00Z reopen — an arming forgotten on Friday
# must not flatten Monday's position seconds after it opens.
After=network-online.target

[Service]
Type=simple
# ★★2026-09-24 alphabot, NOT root. This service and gazbot7-web SHARE data/step_away.json, and
# whichever wrote last OWNED it — so when the watcher (root) expired an arming, the web process
# (alphabot) could no longer write the file and the ARM button returned "error 13, permission
# denied". Two services writing one file under two users is the bug; matching the user is the fix.
# ⚠ Everything it touches must be alphabot-writable: step_away.json, step_away.log, and the claim
# file it writes on a breach.
User=alphabot
Environment=HOME=/home/alphabot
Environment=PYTHONPATH=src
WorkingDirectory=/home/alphabot/gazbot7
MemoryMax=200M
Restart=always
RestartSec=5
ExecStart=/home/alphabot/gazbot7/.venv/bin/python scripts/step_away.py

[Install]
WantedBy=multi-user.target
