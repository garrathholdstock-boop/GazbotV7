[Unit]
Description=GAZBOT V7 — tape watcher timer (weekdays 13:30-20:00 UTC; script sets the cadence)

[Timer]
# Fires every minute across the whole span; the SCRIPT decides whether to act (every minute in the
# 13:30-14:30 open hour, every 3rd minute in the 14:30-20:00 afternoon fade window). Keeping the cadence
# in one place means the timer cannot disagree with the script about when it should run, and a skipped
# invocation costs milliseconds. Ranges are per-hour because systemd cannot express a range that
# crosses the hour boundary (verified: systemd-analyze rejects '13:30..14:29').
OnCalendar=Mon-Fri *-*-* 13:30..59:00
OnCalendar=Mon-Fri *-*-* 14..19:*:00
Persistent=false
AccuracySec=5s

[Install]
WantedBy=timers.target
